{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "El servicio responde.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Chequeo de salud del servicio.",
        "tags": [
          "health"
        ]
      }
    },
    "/catalog-items": {
      "post": {
        "operationId": "CatalogController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCatalogItemDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Elemento creado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada invalidos."
          },
          "409": {
            "description": "Ya existe (catalog, code)."
          }
        },
        "summary": "Crea un elemento de catalogo.",
        "tags": [
          "catalog-items"
        ]
      },
      "get": {
        "operationId": "CatalogController_findMany",
        "parameters": [
          {
            "name": "active",
            "required": false,
            "in": "query",
            "description": "Filtra por estado activo.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "catalog",
            "required": false,
            "in": "query",
            "description": "Filtra por maestra (se normaliza a MAYUSCULAS).",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de elementos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogItemResponseDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parametros de filtro invalidos."
          }
        },
        "summary": "Lista elementos de catalogo, con filtros opcionales.",
        "tags": [
          "catalog-items"
        ]
      }
    },
    "/catalog-items/{id}": {
      "get": {
        "operationId": "CatalogController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador UUID del elemento.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Elemento encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "El id no es un UUID valido."
          },
          "404": {
            "description": "Elemento no encontrado."
          }
        },
        "summary": "Obtiene un elemento de catalogo por id.",
        "tags": [
          "catalog-items"
        ]
      },
      "patch": {
        "operationId": "CatalogController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador UUID del elemento.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCatalogItemDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Elemento actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada invalidos o id no UUID."
          },
          "404": {
            "description": "Elemento no encontrado."
          }
        },
        "summary": "Actualiza label, active o sortOrder de un elemento.",
        "tags": [
          "catalog-items"
        ]
      }
    },
    "/shopping-list-items": {
      "post": {
        "operationId": "ShoppingListController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShoppingListItemDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Producto creado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShoppingListItemResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada invalidos."
          }
        },
        "summary": "Crea un producto en la lista de mercado.",
        "tags": [
          "shopping-list-items"
        ]
      },
      "get": {
        "operationId": "ShoppingListController_findMany",
        "parameters": [
          {
            "name": "active",
            "required": false,
            "in": "query",
            "description": "Filtra por estado activo.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "purchased",
            "required": false,
            "in": "query",
            "description": "Filtra por estado comprado.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Filtra por categoria.",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de productos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShoppingListItemResponseDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parametros de filtro invalidos."
          }
        },
        "summary": "Lista productos de la lista de mercado, con filtros opcionales.",
        "tags": [
          "shopping-list-items"
        ]
      }
    },
    "/shopping-list-items/{id}": {
      "get": {
        "operationId": "ShoppingListController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador UUID del producto.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Producto encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShoppingListItemResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "El id no es un UUID valido."
          },
          "404": {
            "description": "Producto no encontrado."
          }
        },
        "summary": "Obtiene un producto de la lista por id.",
        "tags": [
          "shopping-list-items"
        ]
      },
      "patch": {
        "operationId": "ShoppingListController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador UUID del producto.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShoppingListItemDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Producto actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShoppingListItemResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada invalidos o id no UUID."
          },
          "404": {
            "description": "Producto no encontrado."
          }
        },
        "summary": "Actualiza los datos de un producto de la lista.",
        "tags": [
          "shopping-list-items"
        ]
      }
    }
  },
  "info": {
    "title": "Plantilla Portales API",
    "description": "API estandar para portales internos",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "plantilla-portales-api"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "service",
          "timestamp"
        ]
      },
      "CreateCatalogItemDto": {
        "type": "object",
        "properties": {
          "catalog": {
            "type": "string",
            "description": "Maestra a la que pertenece la opcion (se normaliza a MAYUSCULAS).",
            "example": "PRIORITY",
            "maxLength": 100
          },
          "code": {
            "type": "string",
            "description": "Codigo estable de la opcion dentro del catalogo (se normaliza a MAYUSCULAS).",
            "example": "HIGH",
            "maxLength": 100
          },
          "label": {
            "type": "string",
            "description": "Texto visible al usuario.",
            "example": "Alta",
            "maxLength": 255
          },
          "active": {
            "type": "boolean",
            "description": "Indica si la opcion esta activa. Por defecto true.",
            "default": true,
            "example": true
          },
          "sortOrder": {
            "type": "number",
            "description": "Orden de la opcion dentro del catalogo. Por defecto 0.",
            "default": 0,
            "minimum": 0,
            "example": 1
          }
        },
        "required": [
          "catalog",
          "code",
          "label"
        ]
      },
      "CatalogItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador unico."
          },
          "catalog": {
            "type": "string",
            "description": "Maestra a la que pertenece la opcion.",
            "example": "PRIORITY"
          },
          "code": {
            "type": "string",
            "description": "Codigo estable de la opcion.",
            "example": "HIGH"
          },
          "label": {
            "type": "string",
            "description": "Texto visible al usuario.",
            "example": "Alta"
          },
          "active": {
            "type": "boolean",
            "description": "Indica si la opcion esta activa.",
            "example": true
          },
          "sortOrder": {
            "type": "number",
            "description": "Orden dentro del catalogo.",
            "example": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de creacion."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de ultima actualizacion."
          }
        },
        "required": [
          "id",
          "catalog",
          "code",
          "label",
          "active",
          "sortOrder",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateCatalogItemDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Texto visible al usuario.",
            "example": "Alta",
            "maxLength": 255
          },
          "active": {
            "type": "boolean",
            "description": "Indica si la opcion esta activa.",
            "example": false
          },
          "sortOrder": {
            "type": "number",
            "description": "Orden de la opcion dentro del catalogo.",
            "minimum": 0,
            "example": 2
          }
        }
      },
      "CreateShoppingListItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre del producto a comprar.",
            "example": "Leche",
            "maxLength": 255
          },
          "quantity": {
            "type": "number",
            "description": "Cantidad del producto. Por defecto 1.",
            "default": 1,
            "minimum": 1,
            "example": 2
          },
          "unit": {
            "type": "string",
            "description": "Code de la maestra UNIDAD. Por defecto \"UNIDAD\". Debe ser un code activo de esa maestra.",
            "default": "UNIDAD",
            "example": "L",
            "maxLength": 50
          },
          "category": {
            "type": "string",
            "description": "Code de la maestra CATEGORIA (opcional). Debe ser un code activo de esa maestra.",
            "example": "LACTEOS",
            "maxLength": 100
          },
          "purchased": {
            "type": "boolean",
            "description": "Indica si el producto ya fue comprado. Por defecto false.",
            "default": false,
            "example": false
          },
          "active": {
            "type": "boolean",
            "description": "Indica si el producto esta activo. Por defecto true.",
            "default": true,
            "example": true
          },
          "notes": {
            "type": "string",
            "description": "Notas adicionales del producto (opcional).",
            "example": "Marca sin lactosa",
            "maxLength": 1000
          }
        },
        "required": [
          "name"
        ]
      },
      "ShoppingListItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador unico."
          },
          "name": {
            "type": "string",
            "description": "Nombre del producto.",
            "example": "Leche"
          },
          "quantity": {
            "type": "number",
            "description": "Cantidad del producto.",
            "example": 2
          },
          "unit": {
            "type": "string",
            "description": "Unidad de medida.",
            "example": "litro"
          },
          "category": {
            "type": "string",
            "nullable": true,
            "description": "Categoria del producto.",
            "example": "Lacteos"
          },
          "purchased": {
            "type": "boolean",
            "description": "Indica si el producto ya fue comprado.",
            "example": false
          },
          "active": {
            "type": "boolean",
            "description": "Indica si el producto esta activo.",
            "example": true
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "Notas adicionales.",
            "example": "Marca sin lactosa"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de creacion."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de ultima actualizacion."
          }
        },
        "required": [
          "id",
          "name",
          "quantity",
          "unit",
          "category",
          "purchased",
          "active",
          "notes",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateShoppingListItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre del producto a comprar.",
            "example": "Leche",
            "maxLength": 255
          },
          "quantity": {
            "type": "number",
            "description": "Cantidad del producto.",
            "minimum": 1,
            "example": 2
          },
          "unit": {
            "type": "string",
            "description": "Code de la maestra UNIDAD. Debe ser un code activo.",
            "example": "L",
            "maxLength": 50
          },
          "category": {
            "type": "string",
            "description": "Code de la maestra CATEGORIA. Debe ser un code activo.",
            "example": "LACTEOS",
            "maxLength": 100
          },
          "purchased": {
            "type": "boolean",
            "description": "Indica si el producto ya fue comprado.",
            "example": true
          },
          "active": {
            "type": "boolean",
            "description": "Indica si el producto esta activo.",
            "example": false
          },
          "notes": {
            "type": "string",
            "description": "Notas adicionales del producto.",
            "example": "Marca sin lactosa",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
